(
    `terminals`: {
        '!': ~
        '_': ~
        '(': ~
        ')': ~
        '[': ~
        ']': ~
        '{': ~
        '}': ~
        '@': ~
        '*': ~
        '#': ~
        '<': ~
        '>': ~
        '|': ~
        '~': ~
        ':': ~
        'Text': ~
    }
    `keywords`: {

    }
    `nonterminals`: {
        'Document': | `sequence` < {
            'header': | `optional` | `sequence` < {
                'token': | `terminal` "!"
                'value': | `nonterminal` "Value"
            } >
            'content': | `nonterminal` "Value"
        } >
        'ID Value Pairs': | `repetition` < | `sequence` < {
            'id': | `terminal` "Text"
            'token': | `terminal` ":"
            'value': | `nonterminal` "Value"
        } > _ >
        'Items': | `repetition` < | `nonterminal` "Value" _ >
        'Value': | `sequence` < {
            'type': | `alternation` < {
                'concrete': | `alternation` < {
                    'dictionary': | `sequence` < {
                        'open token': | `terminal` "{"
                        'entries': | `nonterminal` "ID Value Pairs"
                        'close token': | `terminal` "}"
                    } >
                    'group': | `alternation` < {
                        'concise': | `sequence` < {
                            'open token': | `terminal` "<"
                            'properties': | `nonterminal` "Items"
                            'close token': | `terminal` ">"
                        } >
                        'verbose': | `sequence` < {
                            'open token': | `terminal` "("
                            'properties': | `nonterminal` "ID Value Pairs"
                            'close token': | `terminal` ")"
                        } >
                    } >
                    'list': | `sequence` < {
                        'open token': | `terminal` "["
                        'items': | `nonterminal` "Items"
                        'close token': | `terminal` "]"
                    } >
                    'nothing': | `sequence` < {
                        'token': | `terminal` "~"
                    } >
                    'optional': | `alternation` < {
                        'set': | `sequence` < {
                            'token': | `terminal` "*"
                            'value': | `nonterminal` "Value"
                        } >
                        'not set': | `terminal` "_"
                    } >
                    'state': | `sequence` < {
                        'token': | `terminal` "|"
                        'status': | `alternation` < {
                            'missing': | `terminal` "#"
                            'set': | `sequence` < {
                                'option': | `terminal` "Text"
                                'value': | `nonterminal` "Value"
                            } >
                        } >
                    } >
                    'text': | `terminal` "Text"
                } >
                'include': | `sequence` < {
                    'token': | `terminal` "@"
                    'path': | `terminal` "Text"
                } >
                'missing': | `sequence` < {
                    'token': | `terminal` "#"
                } >
            } >
        } >
    }
)