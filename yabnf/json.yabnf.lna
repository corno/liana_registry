(
    `terminals`: {
        '}': ~
        '{': ~
        '[': ~
        ']': ~
        ',': ~
        ':': ~
        'identifier': ~
        'string': ~
        'number': ~
    }
    `keywords`: {
        'false': "identifier"
        'true': "identifier"
        'null': "identifier"
    }
    `nonterminals`: {
        'Value': | `sequence` < {
            'type': | `alternation` < {
                'array': | `sequence` < {
                    '[': | `terminal` "["
                    'items': | `repetition` < | `nonterminal` "Value" * < "," false > >
                    ']': | `terminal` "]"
                } >
                'false': | `keyword` "false"
                'null': | `keyword` "null"
                'number': | `terminal` "number"
                'object': | `sequence` < {
                    '{': | `terminal` "{"
                    'entries': | `repetition` < | `sequence` < {
                        'key': | `terminal` "string"
                        ':': | `terminal` ":"
                        'value': | `nonterminal` "Value"
                    } > * < "," false > >
                    '}': | `terminal` "}"
                } >
                'string': | `terminal` "string"
                'true': | `keyword` "true"
            } >
        } >
    }
)