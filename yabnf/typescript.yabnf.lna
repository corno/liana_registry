(
    `terminals`: {
        '--': ~
        '-': ~
        '-=': ~
        ',': ~
        ';': ~
        ':': ~
        '!': ~
        '!=': ~
        '!==': ~
        '??': ~
        '??=': ~
        '?.': ~
        '?': ~
        '...': ~
        '.': ~
        '(': ~
        ')': ~
        '[': ~
        ']': ~
        '{': ~
        '}': ~
        '@': ~
        '*': ~
        '**': ~
        '**=': ~
        '*=': ~
        '/': ~
        '/=': ~
        '&': ~
        '&&': ~
        '&&=': ~
        '&=': ~
        '%': ~
        '%=': ~
        '^': ~
        '^=': ~
        '+': ~
        '++': ~
        '+=': ~
        '<': ~
        '<<': ~
        '<<=': ~
        '<=': ~
        '=': ~
        '==': ~
        '===': ~
        '=>': ~
        '>': ~
        '>=': ~
        '>>': ~
        '>>=': ~
        '>>>': ~
        '>>>=': ~
        '|': ~
        '|=': ~
        '||': ~
        '||=': ~
        '~': ~
        'Literal': ~
        'Blob': ~
    }
    `keywords`: {
        'abstract': "Identifier"
        'accessor': "Identifier"
        'any': "Identifier"
        'as': "Identifier"
        'asserts': "Identifier"
        'async': "Identifier"
        'await': "Identifier"
        'bigint': "Identifier"
        'boolean': "Identifier"
        'break': "Identifier"
        'case': "Identifier"
        'catch': "Identifier"
        'class': "Identifier"
        'const': "Identifier"
        'constructor': "Identifier"
        'continue': "Identifier"
        'debugger': "Identifier"
        'declare': "Identifier"
        'default': "Identifier"
        'defer': "Identifier"
        'delete': "Identifier"
        'do': "Identifier"
        'else': "Identifier"
        'enum': "Identifier"
        'export': "Identifier"
        'extends': "Identifier"
        'false': "Identifier"
        'finally': "Identifier"
        'for': "Identifier"
        'from': "Identifier"
        'function': "Identifier"
        'get': "Identifier"
        'global': "Identifier"
        'if': "Identifier"
        'implements': "Identifier"
        'import': "Identifier"
        'in': "Identifier"
        'infer': "Identifier"
        'instanceof': "Identifier"
        'interface': "Identifier"
        'intrinsic': "Identifier"
        'is': "Identifier"
        'keyof': "Identifier"
        'let': "Identifier"
        'module': "Identifier"
        'namespace': "Identifier"
        'never': "Identifier"
        'new': "Identifier"
        'null': "Identifier"
        'number': "Identifier"
        'object': "Identifier"
        'of': "Identifier"
        'out': "Identifier"
        'override': "Identifier"
        'private': "Identifier"
        'protected': "Identifier"
        'public': "Identifier"
        'readonly': "Identifier"
        'require': "Identifier"
        'return': "Identifier"
        'satisfies': "Identifier"
        'set': "Identifier"
        'static': "Identifier"
        'string': "Identifier"
        'super': "Identifier"
        'switch': "Identifier"
        'symbol': "Identifier"
        'this': "Identifier"
        'throw': "Identifier"
        'true': "Identifier"
        'try': "Identifier"
        'type': "Identifier"
        'typeof': "Identifier"
        'undefined': "Identifier"
        'unique': "Identifier"
        'unknown': "Identifier"
        'using': "Identifier"
        'var': "Identifier"
        'void': "Identifier"
        'while': "Identifier"
        'with': "Identifier"
        'yield': "Identifier"

    }
    `nonterminals`: {
        'Arguments': | `sequence` < {
            'question dot token': | `optional` | `terminal` "?."
            'type arguments': | `nonterminal` "Type Arguments"
            'error recovery': | `nonterminal` "Error Recovery"
            'open parenthesis token': | `terminal` "("
            'arguments': | `repetition` < | `alternation` < {
                'expression': | `nonterminal` "Expression"
                'spread': | `sequence` < {
                    'dot dot dot token': | `terminal` "..."
                    'expression': | `nonterminal` "Expression"
                } >
            } > * < "," true > >
            'close parenthesis token': | `terminal` ")"
        } >
        'As Alias': | `sequence` < {
            'as keyword': | `terminal` "as"
            'identifier': | `alternation` < {
                'identifier': | `nonterminal` "Identifier"
                'string literal': | `nonterminal` "String Literal"
            } >
        } >
        'Binding Pattern': | `sequence` < {
            'jsdoc': | `nonterminal` "JSDoc"
            'modifiers': | `optional` | `repetition` < | `alternation` < {
                'async': | `terminal` "async"
                'declare': | `terminal` "declare"
                'decorator': | `sequence` < {
                    'at token': | `terminal` "@"
                    'expression': | `nonterminal` "Expression"
                } >
                'export': | `terminal` "export"
                'override': | `terminal` "override"
                'private': | `terminal` "private"
                'protected': | `terminal` "protected"
                'public': | `terminal` "public"
                'readonly': | `terminal` "readonly"
                'static': | `terminal` "static"
            } > _ >
            'dot dot dot token': | `optional` | `terminal` "..."
            'type': | `alternation` < {
                'array binding pattern': | `sequence` < {
                    'open bracket token': | `terminal` "["
                    'elements': | `repetition` < | `optional` | `sequence` < {
                        'dot dot dot token': | `optional` | `terminal` "..."
                        'name': | `nonterminal` "Binding Pattern"
                        'initializer': | `nonterminal` "Optional Initializer"
                    } > * < "," true > >
                    'close bracket token': | `terminal` "]"
                } >
                'identifier': | `nonterminal` "Identifier"
                'number keyword': | `terminal` "number"
                'object binding pattern': | `sequence` < {
                    'open brace token': | `terminal` "{"
                    'elements': | `repetition` < | `sequence` < {
                        'dot dot dot token': | `optional` | `terminal` "..."
                        'property name': | `nonterminal` "Property Name"
                        'binding': | `optional` | `sequence` < {
                            'colon token': | `terminal` ":"
                            'pattern': | `nonterminal` "Binding Pattern"
                        } >
                        'initializer': | `nonterminal` "Optional Initializer"
                    } > * < "," true > >
                    'close brace token': | `terminal` "}"
                } >
                'string keyword': | `terminal` "string"
            } >
        } >
        'Block': | `sequence` < {
            'jsdoc': | `nonterminal` "JSDoc"
            'open brace token': | `terminal` "{"
            'statements': | `nonterminal` "Statements"
            'close brace token': | `terminal` "}"
        } >
        'Class': | `sequence` < {
            'jsdoc': | `nonterminal` "JSDoc"
            'modifiers': | `optional` | `repetition` < | `alternation` < {
                'abstract': | `terminal` "abstract"
                'declare': | `terminal` "declare"
                'decorator': | `sequence` < {
                    'at token': | `terminal` "@"
                    'expression': | `nonterminal` "Expression"
                } >
            } > _ >
            'class keyword': | `terminal` "class"
            'identifier': | `optional` | `nonterminal` "Identifier"
            'type parameters': | `nonterminal` "Type Parameters"
            'heritage': | `nonterminal` "Heritage"
            'body': | `nonterminal` "Class Body"
        } >
        'Class Body': | `sequence` < {
            'open brace token': | `terminal` "{"
            'members': | `repetition` < | `alternation` < {
                'constructor': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'constructor keyword': | `alternation` < {
                        'constructor keyword': | `terminal` "constructor"
                        'constructor keyword as string literal': | `terminal` "\"constructor\""
                    } >
                    'type parameters': | `nonterminal` "Type Parameters"
                    'parameters': | `nonterminal` "Parameters"
                    'return type': | `nonterminal` "Return Type Annotation"
                    'body': | `optional` | `nonterminal` "Block"
                    'semicolon': | `nonterminal` "Semi Colon"
                } >
                'get accessor': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'get keyword': | `terminal` "get"
                    'name': | `nonterminal` "Property Name"
                    'type parameters': | `nonterminal` "Type Parameters"
                    'parameters': | `nonterminal` "Parameters"
                    'return type': | `nonterminal` "Return Type Annotation"
                    'body': | `optional` | `nonterminal` "Block"
                    'semicolon': | `nonterminal` "Semi Colon"
                } >
                'index signature': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'open bracket token': | `terminal` "["
                    'parameter': | `repetition` < | `sequence` < {
                        'jsdoc': | `nonterminal` "JSDoc"
                        'modifiers': | `nonterminal` "Signature Modifiers"
                        'dot dot dot token': | `optional` | `terminal` "..."
                        'identifier': | `nonterminal` "Identifier"
                        'question token': | `optional` | `terminal` "?"
                        'annotation': | `optional` | `sequence` < {
                            'colon token': | `terminal` ":"
                            'type': | `nonterminal` "Type"
                        } >
                        'initializer': | `nonterminal` "Optional Initializer"
                    } > * < "," false > >
                    'close bracket token': | `terminal` "]"
                    'return type': | `nonterminal` "Return Type Annotation"
                    'semicolon': | `nonterminal` "Semi Colon"
                    'comma': | `optional` | `terminal` ","
                } >
                'method': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'asterisk token': | `optional` | `terminal` "*"
                    'name': | `nonterminal` "Property Name"
                    'question token': | `optional` | `terminal` "?"
                    'type parameters': | `nonterminal` "Type Parameters"
                    'parameters': | `nonterminal` "Parameters"
                    'return type': | `nonterminal` "Return Type Annotation"
                    'body': | `optional` | `nonterminal` "Block"
                    'semicolon': | `nonterminal` "Semi Colon"
                } >
                'property': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'name': | `nonterminal` "Property Name"
                    'question token': | `optional` | `terminal` "?"
                    'exclamation token': | `optional` | `terminal` "!"
                    'type': | `nonterminal` "Optional Type"
                    'initializer': | `nonterminal` "Optional Initializer"
                    'semicolon': | `nonterminal` "Semi Colon"
                } >
                'semicolon element': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                } >
                'set accessor': | `sequence` < {
                    'jsdoc': | `nonterminal` "JSDoc"
                    'modifiers': | `nonterminal` "Signature Modifiers"
                    'set keyword': | `terminal` "set"
                    'name': | `nonterminal` "Property Name"
                    'type parameters': | `nonterminal` "Type Parameters"
                    'parameters': | `nonterminal` "Parameters"
                    'return type': | `nonterminal` "Return Type Annotation"
                    'body': | `optional` | `nonterminal` "Block"
                    'semicolon': | `nonterminal` "Semi Colon"
                } >
                'static block': | `sequence` < {
                    'modifiers': | `nonterminal` "Statement Modifiers"
                    'static keyword': | `terminal` "static"
                    'body': | `nonterminal` "Block"
                } >
            } > _ >
            'close brace token': | `terminal` "}"
        } >
        'Entity Name': | `alternation` < {
            'identifier': | `nonterminal` "Identifier"
            'qualified name': | `nonterminal` "Qualified Name"
        } >
        'Error Recovery': | `optional` | `sequence` < {
            'entries': | `repetition` < | `nonterminal` "Type" * < "," false > >
            'greater than token': | `optional` | `terminal` ">"
        } >
        'Expression': | `alternation` < {
            'array literal': | `sequence` < {
                'open bracket token': | `terminal` "["
                'elements': | `repetition` < | `optional` | `nonterminal` "Expression" * < "," true > >
                'close bracket token': | `terminal` "]"
            } >
            'arrow function': | `sequence` < {
                'jsdoc': | `nonterminal` "JSDoc"
                'parameters': | `alternation` < {
                    'with parentheses': | `sequence` < {
                        'type parameters': | `nonterminal` "Type Parameters"
                        'parameters': | `nonterminal` "Parameters"
                    } >
                    'without parentheses': | `sequence` < {
                        'parameter': | `sequence` < {
                            'jsdoc': | `nonterminal` "JSDoc"
                            'name': | `nonterminal` "Binding Pattern"
                            'type': | `nonterminal` "Optional Type"
                        } >
                    } >
                } >
                'type': | `nonterminal` "Return Type Annotation"
                'equals greater than token': | `terminal` "=>"
                'body': | `alternation` < {
                    'block': | `nonterminal` "Block"
                    'expression': | `nonterminal` "Expression"
                } >
            } >
            'assertion': | `sequence` < {
                'less than token': | `terminal` "<"
                'type': | `nonterminal` "Type"
                'greater than token': | `terminal` ">"
                'expression': | `nonterminal` "Expression"
            } >
            'as expression': | `sequence` < {
                'expression': | `nonterminal` "Expression"
                'as keyword': | `terminal` "as"
                'type': | `nonterminal` "Type"
            } >
            'await': | `sequence` < {
                'await keyword': | `terminal` "await"
                'expression': | `nonterminal` "Expression"
            } >
            'big int literal': | `terminal` "Literal"
            'binary': | `sequence` < {
                'left': | `nonterminal` "Expression"
                'operator token': | `alternation` < {
                    '^': | `terminal` "^"
                    '^=': | `terminal` "^="
                    '-': | `terminal` "-"
                    '-=': | `terminal` "-="
                    '!=': | `terminal` "!="
                    '!==': | `terminal` "!=="
                    '??': | `terminal` "??"
                    '??=': | `terminal` "??="
                    '*': | `terminal` "*"
                    '**': | `terminal` "**"
                    '**=': | `terminal` "**="
                    '*=': | `terminal` "*="
                    '/': | `terminal` "/"
                    '/=': | `terminal` "/="
                    '&': | `terminal` "&"
                    '&=': | `terminal` "&="
                    '&&': | `terminal` "&&"
                    '&&=': | `terminal` "&&="
                    '%': | `terminal` "%"
                    '%=': | `terminal` "%="
                    '+': | `terminal` "+"
                    '+=': | `terminal` "+="
                    '<': | `terminal` "<"
                    '<<': | `terminal` "<<"
                    '<<=': | `terminal` "<<="
                    '<=': | `terminal` "<="
                    '=': | `terminal` "="
                    '==': | `terminal` "=="
                    '===': | `terminal` "==="
                    '>': | `terminal` ">"
                    '>=': | `terminal` ">="
                    '>>': | `terminal` ">>"
                    '>>=': | `terminal` ">>="
                    '>>>=': | `terminal` ">>>="
                    '>>>': | `terminal` ">>>"
                    '|': | `terminal` "|"
                    '|=': | `terminal` "|="
                    '||': | `terminal` "||"
                    '||=': | `terminal` "||="
                    'in': | `terminal` "in"
                    'instanceof': | `terminal` "instanceof"
                    ',': | `terminal` ","
                } >
                'right': | `nonterminal` "Expression"
            } >
            'call': | `sequence` < {
                'callee': | `alternation` < {
                    'import': | `terminal` "import"
                    'expression': | `nonterminal` "Expression"
                    'super': | `terminal` "super"
                } >
                'type arguments': | `nonterminal` "Type Arguments"
                'arguments': | `nonterminal` "Arguments"
            } >
            'class': | `nonterminal` "Class"
            'conditional': | `sequence` < {
                'condition': | `nonterminal` "Expression"
                'question token': | `terminal` "?"
                'when true': | `nonterminal` "Expression"
                'colon token': | `terminal` ":"
                'when false': | `nonterminal` "Expression"
            } >
            'delete': | `sequence` < {
                'delete keyword': | `terminal` "delete"
                'expression': | `nonterminal` "Expression"
            } >
            'element access': | `sequence` < {
                'expression': | `nonterminal` "Expression"
                'question dot token': | `optional` | `terminal` "?."
                'open bracket token': | `terminal` "["
                'argument expression': | `nonterminal` "Expression"
                'close bracket token': | `terminal` "]"
            } >
            'external module reference': | `sequence` < {
                'require keyword': | `terminal` "require"
                'open parenthesis token': | `terminal` "("
                'module name': | `nonterminal` "String Literal"
                'close parenthesis token': | `terminal` ")"
            } >
            'false keyword': | `terminal` "false"
            'function': | `sequence` < {
                'jsdoc': | `nonterminal` "JSDoc"
                'modifiers': | `optional` | `repetition` < | `terminal` "async" _ >
                'function keyword': | `terminal` "function"
                'asterisk token': | `optional` | `terminal` "*"
                'name': | `optional` | `nonterminal` "Identifier"
                'type parameters': | `nonterminal` "Type Parameters"
                'parameters': | `nonterminal` "Parameters"
                'return type': | `nonterminal` "Return Type Annotation"
                'body': | `nonterminal` "Block"
            } >
            'identifier': | `nonterminal` "Identifier"
            'import keyword': | `terminal` "import"
            'jsdoc': | `terminal` "Blob"
            'meta property': | `sequence` < {
                'new keyword': | `alternation` < {
                    'new keyword': | `terminal` "new"
                    'import keyword': | `terminal` "import"
                } >
                'dot token': | `terminal` "."
                'identifier': | `nonterminal` "Identifier"
            } >
            'new': | `sequence` < {
                'new keyword': | `terminal` "new"
                'expression': | `nonterminal` "Expression"
                'arguments': | `optional` | `nonterminal` "Arguments"
            } >
            'no substitution template literal': | `terminal` "Literal"
            'non null': | `sequence` < {
                'expression': | `nonterminal` "Expression"
                'exclamation token': | `terminal` "!"
            } >
            'null keyword': | `terminal` "null"
            'numeric literal': | `terminal` "Literal"
            'object literal': | `sequence` < {
                'open brace token': | `terminal` "{"
                'properties': | `repetition` < | `alternation` < {
                            'property': | `sequence` < {
                                'jsdoc': | `nonterminal` "JSDoc"
                                'name': | `nonterminal` "Property Name"
                                'question token': | `optional` | `terminal` "?"
                                'colon token': | `terminal` ":"
                                'initializer': | `nonterminal` "Expression"
                            } >
                            'shorthand property': | `sequence` < {
                                'jsdoc': | `nonterminal` "JSDoc"
                                'name': | `nonterminal` "Identifier"
                                'initializer': | `optional` | `sequence` < {
                                    'equals token': | `terminal` "="
                                    'expression': | `nonterminal` "Expression"
                                } >
                                'question token': | `optional` | `terminal` "?"
                                'exclamation token': | `optional` | `terminal` "!"
                            } >
                            'method': | `sequence` < {
                                'jsdoc': | `nonterminal` "JSDoc"
                                'modifiers': | `nonterminal` "Signature Modifiers"
                                'asterisk token': | `optional` | `terminal` "*"
                                'name': | `nonterminal` "Property Name"
                                'question token': | `optional` | `terminal` "?"
                                'exclamation token': | `optional` | `terminal` "!"
                                'type parameters': | `nonterminal` "Type Parameters"
                                'parameters': | `nonterminal` "Parameters"
                                'return type': | `nonterminal` "Return Type Annotation"
                                'body': | `optional` | `nonterminal` "Block"
                                'semicolon': | `nonterminal` "Semi Colon"
                            } >
                            'spread': | `sequence` < {
                                'dot dot dot token': | `terminal` "..."
                                'expression': | `nonterminal` "Expression"
                            } >
                            'get accessor': | `sequence` < {
                                'jsdoc': | `nonterminal` "JSDoc"
                                'modifiers': | `nonterminal` "Signature Modifiers"
                                'get keyword': | `terminal` "get"
                                'name': | `nonterminal` "Property Name"
                                'parameters': | `nonterminal` "Parameters"
                                'return type': | `nonterminal` "Return Type Annotation"
                                'body': | `optional` | `nonterminal` "Block"
                            } >
                            'set accessor': | `sequence` < {
                                'jsdoc': | `nonterminal` "JSDoc"
                                'set keyword': | `terminal` "set"
                                'name': | `nonterminal` "Property Name"
                                'parameters': | `nonterminal` "Parameters"
                                'return type': | `nonterminal` "Return Type Annotation"
                                'body': | `optional` | `nonterminal` "Block"
                            } >
                } > * < "," true > >
                'close brace token': | `terminal` "}"
            } >
            'omitted expression': | `terminal` ","
            'parenthesized': | `sequence` < {
                'jsdoc': | `nonterminal` "JSDoc"
                'open parenthesis token': | `terminal` "("
                'expression': | `nonterminal` "Expression"
                'close parenthesis token': | `terminal` ")"
            } >
            'postfix unary': | `sequence` < {
                'operand': | `nonterminal` "Expression"
                'operator token': | `alternation` < {
                    '--': | `terminal` "--"
                    '++': | `terminal` "++"
                } >
            } >
            'prefix unary': | `sequence` < {
                'operator token': | `alternation` < {
                    '--': | `terminal` "--"
                    '-': | `terminal` "-"
                    '!': | `terminal` "!"
                    '+': | `terminal` "+"
                    '++': | `terminal` "++"
                    '~': | `terminal` "~"
                } >
                'operand': | `nonterminal` "Expression"
            } >
            'private identifier': | `terminal` "Literal"
            'property access': | `sequence` < {
                'expression': | `nonterminal` "Expression"
                'dot token': | `alternation` < {
                    '.': | `terminal` "."
                    '?.': | `terminal` "?."
                } >
                'identifier': | `alternation` < {
                    'named': | `nonterminal` "Identifier"
                    'private': | `nonterminal` "Identifier"
                } >
            } >
            'qualified name': | `nonterminal` "Qualified Name"
            'regular expression literal': | `terminal` "Literal"
            'satisfies': | `sequence` < {
                'expression': | `nonterminal` "Expression"
                'satisfies keyword': | `terminal` "satisfies"
                'type': | `nonterminal` "Type"
            } >
            'string literal': | `nonterminal` "String Literal"
            'super': | `terminal` "super"
            'tagged template': | `sequence` < {
                'tag': | `nonterminal` "Expression"
                'question dot token': | `optional` | `terminal` "?."
                'type arguments': | `nonterminal` "Type Arguments"
                'template': | `alternation` < {
                    'no substitution template literal': | `terminal` "Literal"
                    'template': | `sequence` < {
                        'head': | `terminal` "Literal"
                        'template spans': | `repetition` < | `sequence` < {
                            'expression': | `nonterminal` "Expression"
                            'suffix': | `alternation` < {
                                'middle': | `terminal` "Literal"
                                'tail': | `terminal` "Literal"
                            } >
                        } > _ >
                    } >
                } >
            } >
            'template': | `sequence` < {
                'head': | `terminal` "Literal"
                'template spans': | `repetition` < | `sequence` < {
                    'expression': | `nonterminal` "Expression"
                    'suffix': | `alternation` < {
                        'middle': | `terminal` "Literal"
                        'tail': | `terminal` "Literal"
                    } >
                } > _ >
            } >
            'this': | `terminal` "this"
            'true keyword': | `terminal` "true"
            'type of': | `sequence` < {
                'type of keyword': | `terminal` "typeof"
                'expression': | `nonterminal` "Expression"
            } >
            'void': | `sequence` < {
                'void keyword': | `terminal` "void"
            } >
            'yield': | `sequence` < {
                'yield keyword': | `terminal` "yield"
                'asterisk token': | `optional` | `terminal` "*"
                'expression': | `optional` | `nonterminal` "Expression"
            } >
            'spread element': | `sequence` < {
                'dot dot dot token': | `terminal` "..."
                'expression': | `nonterminal` "Expression"
            } >
            'with type arguments': | `nonterminal` "Expression With Type Arguments"
        } >
        'Expression With Type Arguments': | `sequence` < {
            'expression': | `nonterminal` "Expression"
            'type arguments': | `nonterminal` "Type Arguments"
        } >
        'Heritage': | `optional` | `repetition` < | `sequence` < {
            'extends or implements keyword': | `alternation` < {
                'extends': | `terminal` "extends"
                'implements': | `terminal` "implements"
            } >
            'types': | `repetition` < | `nonterminal` "Expression With Type Arguments" * < "," false > >
        } > _ >
        'Identifier': | `terminal` "Literal"
        'Import Attributes': | `sequence` < {
            'open brace token': | `terminal` "{"
            'entries': | `repetition` < | `sequence` < {
                'name': | `nonterminal` "Property Name"
                'colon token': | `terminal` ":"
                'value': | `nonterminal` "Expression"
