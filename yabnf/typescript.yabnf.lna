                    '&&=': | `terminal reference` "&&="
                    '%': | `terminal reference` "%"
                    '%=': | `terminal reference` "%="
                    '+': | `terminal reference` "+"
                    '+=': | `terminal reference` "+="
                    '<': | `terminal reference` "<"
                    '<<': | `terminal reference` "<<"
                    '<<=': | `terminal reference` "<<="
                    '<=': | `terminal reference` "<="
                    '=': | `terminal reference` "="
                    '==': | `terminal reference` "=="
                    '===': | `terminal reference` "==="
                    '>': | `terminal reference` ">"
                    '>=': | `terminal reference` ">="
                    '>>': | `terminal reference` ">>"
                    '>>=': | `terminal reference` ">>="
                    '>>>=': | `terminal reference` ">>>="
                    '>>>': | `terminal reference` ">>>"
                    '|': | `terminal reference` "|"
                    '|=': | `terminal reference` "|="
                    '||': | `terminal reference` "||"
                    '||=': | `terminal reference` "||="
                    'in': | `terminal reference` "in"
                    'instanceof': | `terminal reference` "instanceof"
                    ',': | `terminal reference` ","
                } >
                'right': | `nonterminal reference` "Expression"
            } >
            'call': | `sequence` < {
                'callee': | `alternation` < {
                    'import': | `terminal reference` "import"
                    'expression': | `nonterminal reference` "Expression"
                    'super': | `terminal reference` "super"
                } >
                'type arguments': | `nonterminal reference` "Type Arguments"
                'arguments': | `nonterminal reference` "Arguments"
            } >
            'class': | `nonterminal reference` "Class"
            'conditional': | `sequence` < {
                'condition': | `nonterminal reference` "Expression"
                'question token': | `terminal reference` "?"
                'when true': | `nonterminal reference` "Expression"
                'colon token': | `terminal reference` ":"
                'when false': | `nonterminal reference` "Expression"
            } >
            'delete': | `sequence` < {
                'delete keyword': | `terminal reference` "delete"
                'expression': | `nonterminal reference` "Expression"
            } >
            'element access': | `sequence` < {
                'expression': | `nonterminal reference` "Expression"
                'question dot token': | `optional` | `terminal reference` "?."
                'open bracket token': | `terminal reference` "["
                'argument expression': | `nonterminal reference` "Expression"
                'close bracket token': | `terminal reference` "]"
            } >
            'external module reference': | `sequence` < {
                'require keyword': | `terminal reference` "require"
                'open parenthesis token': | `terminal reference` "("
                'module name': | `nonterminal reference` "String Literal"
                'close parenthesis token': | `terminal reference` ")"
            } >
            'false keyword': | `terminal reference` "false"
            'function': | `sequence` < {
                'jsdoc': | `nonterminal reference` "JSDoc"
                'modifiers': | `optional` | `repetition` < | `terminal reference` "async" _ >
                'function keyword': | `terminal reference` "function"
                'asterisk token': | `optional` | `terminal reference` "*"
                'name': | `optional` | `nonterminal reference` "Identifier"
                'type parameters': | `nonterminal reference` "Type Parameters"
                'parameters': | `nonterminal reference` "Parameters"
                'return type': | `nonterminal reference` "Return Type Annotation"
                'body': | `nonterminal reference` "Block"
            } >
            'identifier': | `nonterminal reference` "Identifier"
            'import keyword': | `terminal reference` "import"
            'jsdoc': | `terminal reference` "Blob"
            'meta property': | `sequence` < {
                'new keyword': | `alternation` < {
                    'new keyword': | `terminal reference` "new"
                    'import keyword': | `terminal reference` "import"
                } >
                'dot token': | `terminal reference` "."
                'identifier': | `nonterminal reference` "Identifier"
            } >
            'new': | `sequence` < {
                'new keyword': | `terminal reference` "new"
                'expression': | `nonterminal reference` "Expression"
                'arguments': | `optional` | `nonterminal reference` "Arguments"
            } >
            'no substitution template literal': | `terminal reference` "Literal"
            'non null': | `sequence` < {
                'expression': | `nonterminal reference` "Expression"
                'exclamation token': | `terminal reference` "!"
            } >
            'null keyword': | `terminal reference` "null"
            'numeric literal': | `terminal reference` "Literal"
            'object literal': | `sequence` < {
