    `nonterminals`: {
        'Arguments': | `sequence` < {
            'question dot token': | `optional` | `terminal reference` "?."
            'type arguments': | `nonterminal reference` "Type Arguments"
            'error recovery': | `nonterminal reference` "Error Recovery"
            'open parenthesis token': | `terminal reference` "("
            'arguments': | `repetition` < | `alternation` < {
                'expression': | `nonterminal reference` "Expression"
                'spread': | `sequence` < {
                    'dot dot dot token': | `terminal reference` "..."
                    'expression': | `nonterminal reference` "Expression"
                } >
            } > * < "," true > >
            'close parenthesis token': | `terminal reference` ")"
        } >
        'As Alias': | `sequence` < {
            'as keyword': | `terminal reference` "as"
            'identifier': | `alternation` < {
                'identifier': | `nonterminal reference` "Identifier"
                'string literal': | `nonterminal reference` "String Literal"
            } >
        } >
        'Binding Pattern': | `sequence` < {
            'jsdoc': | `nonterminal reference` "JSDoc"
            'modifiers': | `optional` | `repetition` < | `alternation` < {
                'async': | `terminal reference` "async"
                'declare': | `terminal reference` "declare"
                'decorator': | `sequence` < {
                    'at token': | `terminal reference` "@"
                    'expression': | `nonterminal reference` "Expression"
                } >
                'export': | `terminal reference` "export"
                'override': | `terminal reference` "override"
                'private': | `terminal reference` "private"
                'protected': | `terminal reference` "protected"
                'public': | `terminal reference` "public"
                'readonly': | `terminal reference` "readonly"
                'static': | `terminal reference` "static"
            } > _ >
            'dot dot dot token': | `optional` | `terminal reference` "..."
            'type': | `alternation` < {
                'array binding pattern': | `sequence` < {
                    'open bracket token': | `terminal reference` "["
                    'elements': | `repetition` < | `optional` | `sequence` < {
                        'dot dot dot token': | `optional` | `terminal reference` "..."
                        'name': | `nonterminal reference` "Binding Pattern"
                        'initializer': | `nonterminal reference` "Optional Initializer"
                    } > * < "," true > >
                    'close bracket token': | `terminal reference` "]"
                } >
                'identifier': | `nonterminal reference` "Identifier"
                'number keyword': | `terminal reference` "number"
                'object binding pattern': | `sequence` < {
                    'open brace token': | `terminal reference` "{"
                    'elements': | `repetition` < | `sequence` < {
                        'dot dot dot token': | `optional` | `terminal reference` "..."
                        'property name': | `nonterminal reference` "Property Name"
                        'binding': | `optional` | `sequence` < {
                            'colon token': | `terminal reference` ":"
                            'pattern': | `nonterminal reference` "Binding Pattern"
                        } >
                        'initializer': | `nonterminal reference` "Optional Initializer"
                    } > * < "," true > >
                    'close brace token': | `terminal reference` "}"
                } >
                'string keyword': | `terminal reference` "string"
            } >
        } >
        'Block': | `sequence` < {
            'jsdoc': | `nonterminal reference` "JSDoc"
            'open brace token': | `terminal reference` "{"
            'statements': | `nonterminal reference` "Statements"
            'close brace token': | `terminal reference` "}"
        } >
        'Class': | `sequence` < {
            'jsdoc': | `nonterminal reference` "JSDoc"
            'modifiers': | `optional` | `repetition` < | `alternation` < {
                'abstract': | `terminal reference` "abstract"
                'declare': | `terminal reference` "declare"
                'decorator': | `sequence` < {
                    'at token': | `terminal reference` "@"
                    'expression': | `nonterminal reference` "Expression"
                } >
            } > _ >
            'class keyword': | `terminal reference` "class"
            'identifier': | `optional` | `nonterminal reference` "Identifier"
            'type parameters': | `nonterminal reference` "Type Parameters"
            'heritage': | `nonterminal reference` "Heritage"
            'body': | `nonterminal reference` "Class Body"
        } >
        'Class Body': | `sequence` < {
            'open brace token': | `terminal reference` "{"
            'members': | `repetition` < | `alternation` < {
                'constructor': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'constructor keyword': | `alternation` < {
                        'constructor keyword': | `terminal reference` "constructor"
                        'constructor keyword as string literal': | `terminal reference` "\"constructor\""
                    } >
                    'type parameters': | `nonterminal reference` "Type Parameters"
                    'parameters': | `nonterminal reference` "Parameters"
                    'return type': | `nonterminal reference` "Return Type Annotation"
                    'body': | `optional` | `nonterminal reference` "Block"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                } >
                'get accessor': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'get keyword': | `terminal reference` "get"
                    'name': | `nonterminal reference` "Property Name"
                    'type parameters': | `nonterminal reference` "Type Parameters"
                    'parameters': | `nonterminal reference` "Parameters"
                    'return type': | `nonterminal reference` "Return Type Annotation"
                    'body': | `optional` | `nonterminal reference` "Block"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                } >
                'index signature': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'open bracket token': | `terminal reference` "["
                    'parameter': | `repetition` < | `sequence` < {
                        'jsdoc': | `nonterminal reference` "JSDoc"
                        'modifiers': | `nonterminal reference` "Signature Modifiers"
                        'dot dot dot token': | `optional` | `terminal reference` "..."
                        'identifier': | `nonterminal reference` "Identifier"
                        'question token': | `optional` | `terminal reference` "?"
                        'annotation': | `optional` | `sequence` < {
                            'colon token': | `terminal reference` ":"
                            'type': | `nonterminal reference` "Type"
                        } >
                        'initializer': | `nonterminal reference` "Optional Initializer"
                    } > * < "," false > >
                    'close bracket token': | `terminal reference` "]"
                    'return type': | `nonterminal reference` "Return Type Annotation"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                    'comma': | `optional` | `terminal reference` ","
                } >
                'method': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'asterisk token': | `optional` | `terminal reference` "*"
                    'name': | `nonterminal reference` "Property Name"
                    'question token': | `optional` | `terminal reference` "?"
                    'type parameters': | `nonterminal reference` "Type Parameters"
                    'parameters': | `nonterminal reference` "Parameters"
                    'return type': | `nonterminal reference` "Return Type Annotation"
                    'body': | `optional` | `nonterminal reference` "Block"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                } >
                'property': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'name': | `nonterminal reference` "Property Name"
                    'question token': | `optional` | `terminal reference` "?"
                    'exclamation token': | `optional` | `terminal reference` "!"
                    'type': | `nonterminal reference` "Optional Type"
                    'initializer': | `nonterminal reference` "Optional Initializer"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                } >
                'semicolon element': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                } >
                'set accessor': | `sequence` < {
                    'jsdoc': | `nonterminal reference` "JSDoc"
                    'modifiers': | `nonterminal reference` "Signature Modifiers"
                    'set keyword': | `terminal reference` "set"
                    'name': | `nonterminal reference` "Property Name"
                    'type parameters': | `nonterminal reference` "Type Parameters"
                    'parameters': | `nonterminal reference` "Parameters"
                    'return type': | `nonterminal reference` "Return Type Annotation"
                    'body': | `optional` | `nonterminal reference` "Block"
                    'semicolon': | `nonterminal reference` "Semi Colon"
                } >
                'static block': | `sequence` < {
                    'modifiers': | `nonterminal reference` "Statement Modifiers"
                    'static keyword': | `terminal reference` "static"
                    'body': | `nonterminal reference` "Block"
                } >
            } > _ >
            'close brace token': | `terminal reference` "}"
        } >
        'Entity Name': | `alternation` < {
            'identifier': | `nonterminal reference` "Identifier"
            'qualified name': | `nonterminal reference` "Qualified Name"
        } >
        'Error Recovery': | `optional` | `sequence` < {
            'entries': | `repetition` < | `nonterminal reference` "Type" * < "," false > >
            'greater than token': | `optional` | `terminal reference` ">"
        } >
        'Expression': | `alternation` < {
            'array literal': | `sequence` < {
                'open bracket token': | `terminal reference` "["
                'elements': | `repetition` < | `optional` | `nonterminal reference` "Expression" * < "," true > >
                'close bracket token': | `terminal reference` "]"
            } >
            'arrow function': | `sequence` < {
                'jsdoc': | `nonterminal reference` "JSDoc"
                'parameters': | `alternation` < {
                    'with parentheses': | `sequence` < {
                        'type parameters': | `nonterminal reference` "Type Parameters"
                        'parameters': | `nonterminal reference` "Parameters"
                    } >
                    'without parentheses': | `sequence` < {
                        'parameter': | `sequence` < {
                            'jsdoc': | `nonterminal reference` "JSDoc"
                            'name': | `nonterminal reference` "Binding Pattern"
                            'type': | `nonterminal reference` "Optional Type"
                        } >
                    } >
                } >
                'type': | `nonterminal reference` "Return Type Annotation"
                'equals greater than token': | `terminal reference` "=>"
                'body': | `alternation` < {
                    'block': | `nonterminal reference` "Block"
                    'expression': | `nonterminal reference` "Expression"
                } >
            } >
            'assertion': | `sequence` < {
                'less than token': | `terminal reference` "<"
                'type': | `nonterminal reference` "Type"
                'greater than token': | `terminal reference` ">"
                'expression': | `nonterminal reference` "Expression"
            } >
            'as expression': | `sequence` < {
                'expression': | `nonterminal reference` "Expression"
                'as keyword': | `terminal reference` "as"
                'type': | `nonterminal reference` "Type"
            } >
            'await': | `sequence` < {
                'await keyword': | `terminal reference` "await"
                'expression': | `nonterminal reference` "Expression"
            } >
            'big int literal': | `terminal reference` "Literal"
            'binary': | `sequence` < {
                'left': | `nonterminal reference` "Expression"
                'operator token': | `alternation` < {
                    '^': | `terminal reference` "^"
                    '^=': | `terminal reference` "^="
                    '-': | `terminal reference` "-"
                    '-=': | `terminal reference` "-="
                    '!=': | `terminal reference` "!="
                    '!==': | `terminal reference` "!=="
                    '??': | `terminal reference` "??"
                    '??=': | `terminal reference` "??="
                    '*': | `terminal reference` "*"
